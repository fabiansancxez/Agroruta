# En local no necesitas esta variable (Vite usa el proxy definido en vite.config.js).
# En producción (Render), copia este archivo a ".env" o define la variable
# VITE_API_URL en el panel de Render con la URL de tu backend, por ejemplo:
# VITE_API_URL=https://agroruta-api.onrender.com
VITE_API_URL=
